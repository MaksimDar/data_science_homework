   "source": [
    "**Завдання**\n",
    "В якості домашнього завдання вам пропонується створити рекурентну нейронну мережу за допомогою механізмів Keras, яка буде класифікувати рецензії із датасету imdb. На відміну від прикладу в модулі 9 ми використаємо рекурентну нейронну мережу. Поекспериментуйте з будовою мережі - RNN, LSTM, двостороння та глибока. Порівняйте результати та зробіть висновки."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 261,
   "id": "7b6430aa-80f7-4e80-a1f0-acab479535fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "def show_accuracy_loss(history):\n",
    "    acc = history.history['acc']\n",
    "    val_acc = history.history['val_acc']\n",
    "    loss = history.history['loss']\n",
    "    val_loss = history.history['val_loss']\n",
    "\n",
    "    epochs = range(1, len(acc) + 1)\n",
    "\n",
    "    plt.plot(epochs, acc, 'bo', label='Точність на тренуванні')  # Графік точності на тренувальних данних\n",
    "    plt.plot(epochs, val_acc, 'b', label='Точність на валідації')  # Графік точності на валідаційних данних\n",
    "    plt.title('Точність тренування і валідації')  # Заголовок графіку\n",
    "    plt.legend()  # Показати легенду\n",
    "\n",
    "    plt.figure()\n",
    "\n",
    "    plt.plot(epochs, loss, 'bo', label='Втрати на тренуванні')  # Графік втрат на тренувальних данних\n",
    "    plt.plot(epochs, val_loss, 'b', label='Втрати на валідації')  # Графік втрат на валідаційних данних\n",
    "    plt.title('Втрати тренування і валідації')  # Заголовок графіку\n",
    "    plt.legend()  # Показати легенду\n",
    "\n",
    "    plt.show()  # Відобразити графіки"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 213,
   "id": "65658e44-e2d9-4eb6-a23d-a7230c3ee52a",
   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from tensorflow.keras.datasets import imdb\n",
    "from tensorflow.keras.utils import pad_sequences\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Embedding, SimpleRNN, Dense, Dropout, Input, LSTM, Bidirectional\n",
    "from tensorflow.keras.callbacks import EarlyStopping"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f347b621-9809-4f5d-a48d-3c7aaf2b6ce1",
   "metadata": {},
   "outputs": [],
   "source": [
    "max_features = 15000\n",
    "max_len = 600\n",
    "batch_size = 32"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a48a6a7a-4ab9-4be1-b340-a30fc14db02e",
   "metadata": {},
   "outputs": [],
   "source": [
    "(input_train, y_train), (input_test, y_test) = imdb.load_data(num_words=max_features)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "eea7b487-4304-4227-be06-a04c9585648f",
   "metadata": {},
   "outputs": [],
   "source": [
    "input_train = pad_sequences(input_train,maxlen=max_len)\n",
    "input_test = pad_sequences(input_test,maxlen=max_len)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8eaecebf-c89f-4ae8-b41b-a3ede54e75e0",
   "metadata": {},
   "source": [
    "1. RNN network"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 99,
   "id": "74d64192-e32b-4e85-942f-fdaca9c603b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Побудова  моделі\n",
    "\n",
    "model_rnn = Sequential()\n",
    "\n",
    "# model_rnn.add(Input(shape=(max_len,)))\n",
    "\n",
    "model_rnn.add(Embedding(max_features, 64))\n",
    "\n",
    "model_rnn.add(SimpleRNN(32))\n",
    "\n",
    "# model_rnn.add(Dense(64, activation='relu'))\n",
    "\n",
    "# model_rnn.add(Dropout(0.2))\n",
    "\n",
    "# model_rnn.add(Dense(64, activation='relu'))\n",
    "\n",
    "model_rnn.add(Dropout(0.3))\n",
    "\n",
    "model_rnn.add(Dense(1,activation='sigmoid'))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "id": "ca8a59e3-f876-4524-8c2e-16477313c933",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Компіляція\n",
    "# adam, nadam and rmsprop optimizers\n",
    "model_rnn.compile(optimizer='nadam',loss='binary_crossentropy',metrics=['acc'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "2aa93cd2-c2d1-4930-b000-371ed61f5767",
   "metadata": {},
   "outputs": [],
   "source": [
    "rnn_acc_list = []"
   ]
  },
