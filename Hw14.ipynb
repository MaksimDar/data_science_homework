   ],
   "source": [
    "### Навчання\n",
    " # epochs 5,6,and 10\n",
    "es = EarlyStopping(monitor='val_acc', patience=2, restore_best_weights=True)\n",
    "history = model_rnn.fit(input_train,y_train,epochs=10,batch_size=96,validation_split=0.2, callbacks=[es])\n"
   ]
  },
