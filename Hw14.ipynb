      "Epoch 3/10\n",
      "\u001b[1m209/209\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 53ms/step - acc: 0.9875 - loss: 0.0458 - val_acc: 0.8402 - val_loss: 0.4822\n",
      "Epoch 4/10\n",
      "\u001b[1m209/209\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 51ms/step - acc: 0.9950 - loss: 0.0230 - val_acc: 0.7978 - val_loss: 0.6350\n"
     ]
